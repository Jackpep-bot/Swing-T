# Copy to .env and fill in. Never commit .env.
# --- Market data ---
MASSIVE_API_KEY=            # massive.com (ex-Polygon). Free "Stocks Basic" works for EOD bars.
EODHD_API_KEY=              # optional alternative bar provider
ALPHAVANTAGE_API_KEY=       # free; used only for the earnings calendar
# --- Broker (PAPER keys only until the paper gate is passed) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
# --- Alternative data (optional) ---
QUIVER_API_KEY=
# --- Claude ---
ANTHROPIC_API_KEY=
# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
# --- SEC EDGAR fair-access policy requires a contact in the User-Agent ---
EDGAR_USER_AGENT="swing-engine your-email@example.com"
